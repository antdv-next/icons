{
  "name": "@antdv-next/icons",
  "type": "module",
  "version": "1.0.0-rc.2",
  "description": "Antdv Next icon components for Vue 3.",
  "packageManager": "pnpm@10.18.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antdv-next/icons.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./all": {
      "types": "./dist/icons/index.d.mts",
      "import": "./dist/icons/index.mjs",
      "default": "./dist/icons/index.mjs"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.mts",
      "import": "./dist/icons/*.mjs",
      "default": "./dist/icons/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsdown",
    "gen:icons": "esno ./scripts/gen-icons.ts",
    "prepublish": "pnpm build",
    "bump": "bumpp"
  },
  "peerDependencies": {
    "vue": ">=3.2.0"
  },
  "dependencies": {
    "@ant-design/colors": "7.2.1",
    "@ant-design/icons-svg": "^4.4.2",
    "@v-c/util": "^1.0.9",
    "es-toolkit": "1.43.0"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/tsconfig": "^0.8.1",
    "bumpp": "^10.4.0",
    "esno": "4.8.0",
    "pkg-types": "^2.3.0",
    "tsdown": "^0.20.1",
    "typescript": "~5.9.3",
    "vite": "^8.0.0-beta.8",
    "vite-plugin-tsx-resolve-types": "^1.0.1-beta.5",
    "vitest": "^4.0.17"
  }
}
